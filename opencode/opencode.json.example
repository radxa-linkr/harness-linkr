{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "linkr": {
        "type": "local",
        "command": [
          "node",
          "/absolute/path/to/harness-linkr/mcp-linkr/index.js"
        ],
        "environment": {
          "LINKR_BASE_URL": "http://linkr.local",
          "LINKR_USERNAME": "admin",
          "LINKR_PASSWORD": "the-device-password"
        }
      }
    }
  }
}
